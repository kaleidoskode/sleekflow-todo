# Copy this file to .env and adjust for your machine. .env is gitignored;
# this example is the source of truth for host-side runs (uvicorn, alembic,
# pytest).
#
# These URLs point at the port docker-compose.yml publishes Postgres on:
# by default the container binds host port 5432 and these URLs work as-is.
#
# If a native PostgreSQL already owns port 5432 on your machine, the container
# cannot bind there. Set `DB_PORT=5433` in the compose .env (the file next to
# docker-compose.yml, NOT this one) so the container publishes on 5433, then
# uncomment the alternate lines below so host-side tools follow.
DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo
TEST_DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo_test

# --- Only if port 5432 is taken by another PostgreSQL (e.g. a native install) ---
# DB_PORT=5433
# DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5433/todo
# TEST_DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5433/todo_test
