# Copy to .env.local for local development:
#
#     cp .env.local.example .env.local
#
# .env.local is git-ignored because it holds one machine's credentials. The
# committed .env selects which of these files is read (ENVIRONMENT=local).
#
# These defaults match the Postgres in docker-compose.yml, so this works after
# `docker compose up -d db`. Change the port if 5432 is taken — see the README.
DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo

# The test suite drops and recreates this schema on every run. It must NEVER
# point at the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo_test
