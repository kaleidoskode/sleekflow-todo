# Copy to .env.local and edit — your personal backend config (gitignored).
# This is the default: unset APP_ENV or APP_ENV=local uses this file.
# Use APP_ENV=development to switch to .env.development instead.
DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo
TEST_DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo_test

# If a native PostgreSQL already owns port 5432, change to 5433 and set
# DB_PORT=5433 in the project-root .env for docker-compose.
# DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5433/todo
# TEST_DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5433/todo_test
